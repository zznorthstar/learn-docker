{
  "name": "docker-world",
  "version": "0.1.0",
  "description": "Interactive Docker learning world that your own AI teaches over MCP",
  "license": "MIT",
  "author": "Hamdi ZYG-ZXG",
  "homepage": "https://learndocker.hamdibouzidi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zznorthstar/learn-docker.git"
  },
  "bugs": {
    "url": "https://github.com/zznorthstar/learn-docker/issues"
  },
  "keywords": [
    "docker",
    "mcp",
    "model-context-protocol",
    "rive",
    "cloudflare-workers",
    "durable-objects",
    "education",
    "interactive",
    "simulation",
    "containers"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:relay": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "build:rive": "node rive/gen/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "deploy:relay": "npm run build && wrangler deploy",
    "test:relay": "vitest run --config vitest.relay.config.ts",
    "test:all": "vitest run && vitest run --config vitest.relay.config.ts && npm run test:e2e"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@rive-app/canvas-lite": "^2.44.2"
  }
}
